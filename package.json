{
  "name": "mdecho",
  "version": "1.0.4",
  "description": "AIが生成したMarkdownを、人間がレビューしやすくするためのCLIツール",
  "keywords": ["cli", "markdown", "preview", "viewer", "review", "ai-agent"],
  "homepage": "https://github.com/eetann/mdecho",
  "bugs": {
    "url": "https://github.com/eetann/mdecho/issues"
  },
  "license": "MIT",
  "author": "eetann",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eetann/mdecho.git"
  },
  "type": "module",
  "bin": {
    "mdecho": "dist/index.js"
  },
  "files": ["dist", "docs"],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "bun run build:client && bun run src/index.ts",
    "build": "bun run build:client && bun run build:cli",
    "build:client": "bun run scripts/build-client.ts",
    "build:cli": "bun run scripts/build-cli.ts",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src frontend scripts",
    "lint:fix": "oxlint --fix src frontend scripts",
    "format": "oxfmt src frontend scripts",
    "format:check": "oxfmt --check src frontend scripts",
    "release": "bun run lint && bun run format:check && bun run typecheck && bun run build && bun run test && bunx publint@0.3.24 && bumpp"
  },
  "devDependencies": {
    "@gunshi/docs": "^0.37.1",
    "@types/bun": "latest",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "bumpp": "^12.3.0",
    "bun-plugin-tailwind": "^0.1.2",
    "daisyui": "^5.7.0",
    "lucide-react": "^1.42.0",
    "mdast-util-to-hast": "^13.2.1",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.11",
    "@shikijs/rehype": "^4.3.1",
    "c12": "^3.3.4",
    "chokidar": "^5.0.0",
    "confbox": "^0.3.1",
    "github-slugger": "^2.0.0",
    "gunshi": "^0.37.1",
    "hono": "^4.12.32",
    "jsonc-parser": "^3.3.1",
    "mermaid": "^11.16.0",
    "rehype-stringify": "^10.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.3.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  }
}
